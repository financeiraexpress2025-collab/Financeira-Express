/* ===== PÁGINAS DOS PRODUTOS ===== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Poppins',sans-serif;
    background:#0d0d0d;
    color:#f5f5f5;
}

.produto{
    width:90%;
    max-width:1000px;
    margin:50px auto;
}

.titulo{
    text-align:center;
    color:#d4af37;
    font-size:42px;
    margin-bottom:10px;
    font-weight:700;
}

.subtitulo{
    text-align:center;
    color:#d8d8d8;
    font-size:18px;
    margin-bottom:35px;
}

.bloco{
    background:#181818;
    border:2px solid #d4af37;
    border-radius:18px;
    padding:30px;
    margin-bottom:30px;
}

.bloco h2{
    color:#d4af37;
    margin-bottom:20px;
    font-size:30px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:#222;
    border:1px solid rgba(212,175,55,.35);
    border-radius:15px;
    padding:20px;
}

.card h3{
    color:#d4af37;
    margin-bottom:15px;
}

.card p{
    color:#f5f5f5;
    line-height:1.7;
}

.botao{
    display:block;
    width:320px;
    max-width:100%;
    margin:35px auto 15px;
    text-align:center;
    background:#d4af37;
    color:#111;
    text-decoration:none;
    padding:16px;
    border-radius:12px;
    font-weight:700;
    transition:.3s;
}

.botao:hover{
    background:#b9911f;
}

.voltar{
    display:block;
    text-align:center;
    color:#d4af37;
    text-decoration:none;
    margin-bottom:30px;
}

.voltar:hover{
    text-decoration:underline;
}

@media(max-width:768px){

.titulo{
    font-size:34px;
}

.subtitulo{
    font-size:16px;
}

.bloco{
    padding:20px;
}

.cards{
    grid-template-columns:1fr;
}

.botao{
    width:100%;
}

}
